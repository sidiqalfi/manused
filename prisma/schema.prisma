// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid()) @db.Uuid

  email    String  @unique
  name     String?
  password String
  // Naikkan untuk me-revoke semua JWT aktif milik user ini
  // (dipakai saat ganti password). Lihat jwt callback di auth.ts.
  tokenVersion Int @default(0)

  createdMembers Member[]
  createdCashPeriods CashPeriod[]
  createdCashIncomes CashIncome[]
  createdCashExpenses CashExpense[]
  createdSosialPeriods SosialPeriod[]
  createdSosialIncomes SosialIncome[]
  createdSosialExpenses SosialExpense[]
  createdArisanPeriods ArisanPeriod[]
  createdArisanIncomes ArisanIncome[]
  createdArisanDraws ArisanDraw[]
  createdKegiatans Kegiatan[]
  createdKegiatanParticipants KegiatanParticipant[]
  createdKegiatanPayments KegiatanPayment[]
  createdKegiatanExpenses KegiatanExpense[]

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp(6)
}

enum Gender {
  MALE
  FEMALE
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

enum KegiatanStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

enum IncomeSource {
  IURAN
  SUMBANGAN
  LAINNYA
}

model Member {
  id String @id @default(uuid()) @db.Uuid

  name      String // Nama panggilan
  fullName  String // Nama lengkap
  gender    Gender
  birthDate DateTime @db.Date // Tanggal lahir (hanya tanggal, tanpa waktu)
  address String // Dusun
  rt      String // Tiga digit, misalnya "013"
  rw      String // Tiga digit, misalnya "006"
  phone   String? // Opsional, tidak semua pemuda punya HP

  status      MemberStatus @default(ACTIVE)
  createdById String       @db.Uuid
  createdUser User         @relation(fields: [createdById], references: [id])
  joinDate    DateTime     @default(now()) @db.Date // Tanggal bergabung

  headOfHouseholdId String?  @db.Uuid
  headOfHousehold   Member?  @relation("Household", fields: [headOfHouseholdId], references: [id], onDelete: SetNull)
  householdMembers  Member[] @relation("Household")

  cashIncomes CashIncome[]

  sosialIncomes SosialIncome[]

  arisanIncomes ArisanIncome[]
  arisanDraws  ArisanDraw[]

  kegiatanParticipations KegiatanParticipant[]
  kegiatanPayments       KegiatanPayment[]

  roles MemberRoleAssignment[]

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp(6)
}

model Role {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique
  rank Int    @unique

  memberships MemberRoleAssignment[]

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp(6)
}

model MemberRoleAssignment {
  id        String    @id @default(uuid()) @db.Uuid

  memberId  String    @db.Uuid
  member    Member    @relation(fields: [memberId], references: [id])

  roleId    String    @db.Uuid
  role      Role      @relation(fields: [roleId], references: [id])

  startDate DateTime  @default(now()) @db.Date
  endDate   DateTime? @db.Date

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp(6)

  @@index([memberId, endDate])
  @@index([roleId, endDate])
}

model CashPeriod {
  id String @id @default(uuid()) @db.Uuid

  month      Int // 1-12
  year       Int // 2026
  duesAmount Int // Nominal iuran bulan ini
  minAmount  Int // Batas bawah

  incomes  CashIncome[]
  expenses CashExpense[]

  createdById String @db.Uuid
  createdUser User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp(6)

  @@unique([month, year])
}

model CashIncome {
  id String @id @default(uuid()) @db.Uuid

  periodId String     @db.Uuid
  period   CashPeriod @relation(fields: [periodId], references: [id])

  memberId String? @db.Uuid
  member   Member? @relation(fields: [memberId], references: [id])

  source     IncomeSource @default(IURAN)
  sourceName String? // Nama/asal pemberi sumbangan (opsional)

  amount Int      // Nominal yang dibayar
  paidAt DateTime @db.Date
  note   String?  // Catatan opsional

  createdById String @db.Uuid
  createdUser User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamp(6)

  @@unique([periodId, memberId])
}

model CashExpense {
  id String @id @default(uuid()) @db.Uuid

  periodId    String     @db.Uuid
  period      CashPeriod @relation(fields: [periodId], references: [id])

  description String // "Beli konsumsi rapat", dll
  amount      Int
  spentAt     DateTime @db.Date

  // Opsional: tautkan expense ini ke sebuah Kegiatan (subsidi acara).
  // Hapus kegiatan tidak menghapus expense-nya (SetNull).
  relatedEventId String?   @db.Uuid
  relatedEvent   Kegiatan? @relation("CashExpenseKegiatan", fields: [relatedEventId], references: [id], onDelete: SetNull)

  createdById String @db.Uuid
  createdUser User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamp(6)
}

model SosialPeriod {
  id String @id @default(uuid()) @db.Uuid

  month     Int // 1-12
  year      Int // 2026
  minAmount Int // Batas bawah iuran seiklasnya

  incomes  SosialIncome[]
  expenses SosialExpense[]

  createdById String @db.Uuid
  createdUser User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp(6)

  @@unique([month, year])
}

model SosialIncome {
  id String @id @default(uuid()) @db.Uuid

  periodId String       @db.Uuid
  period   SosialPeriod @relation(fields: [periodId], references: [id])

  memberId String? @db.Uuid
  member   Member? @relation(fields: [memberId], references: [id])

  source     IncomeSource @default(IURAN)
  sourceName String? // Nama/asal pemberi sumbangan (opsional)

  amount Int      // Nominal yang disumbangkan
  paidAt DateTime @db.Date
  note   String?  // Catatan opsional

  createdById String @db.Uuid
  createdUser User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamp(6)

  @@unique([periodId, memberId])
}

model SosialExpense {
  id String @id @default(uuid()) @db.Uuid

  periodId    String       @db.Uuid
  period      SosialPeriod @relation(fields: [periodId], references: [id])

  description String // "Beli konsumsi rapat", dll
  amount      Int
  spentAt     DateTime @db.Date

  createdById String @db.Uuid
  createdUser User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamp(6)
}

model ArisanPeriod {
  id String @id @default(uuid()) @db.Uuid

  month              Int // 1-12
  year               Int // 2026
  contributionAmount Int // Nominal iuran arisan per anggota (default 5000)
  payoutTarget       Int // Nominal yang diterima pemenang (default 135000)

  incomes ArisanIncome[]
  draws   ArisanDraw[]

  createdById String @db.Uuid
  createdUser User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp(6)

  @@unique([month, year])
}

model ArisanIncome {
  id String @id @default(uuid()) @db.Uuid

  periodId String        @db.Uuid
  period   ArisanPeriod  @relation(fields: [periodId], references: [id])

  memberId String @db.Uuid
  member   Member @relation(fields: [memberId], references: [id])

  amount Int      // Nominal yang dibayar (terkunci ke contributionAmount periode)
  paidAt DateTime @db.Date
  note   String?  // Catatan opsional

  createdById String @db.Uuid
  createdUser User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamp(6)

  @@unique([periodId, memberId])
}

model ArisanDraw {
  id String @id @default(uuid()) @db.Uuid

  periodId String       @db.Uuid
  period   ArisanPeriod @relation(fields: [periodId], references: [id])

  winnerMemberId String @db.Uuid
  winnerMember   Member @relation(fields: [winnerMemberId], references: [id])

  cycleNumber     Int // Siklus berjalan (auto-advance bila tidak ada eligible)
  collectedAmount Int // Total iuran terkumpul saat draw
  payoutAmount    Int // Nominal yang dibayarkan ke pemenang
  savingsAfter    Int // Saldo save setelah draw ini (boleh negatif)
  drawnAt         DateTime @db.Date

  voided   Boolean   @default(false)
  voidedAt DateTime? @db.Date

  createdById String @db.Uuid
  createdUser User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamp(6)
}

model Kegiatan {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique // URL-friendly, dibuat sekali saat create — tidak berubah saat rename agar link yang dibagikan tetap hidup

  name         String // "HUT Muda Mudi 2026 — Outbound New Rivermoon"
  eventDate    DateTime @db.Date
  location     String?  // "New Rivermoon"
  feePerPerson Int      // Tarif tetap per peserta (bisa 0)
  status       KegiatanStatus @default(PLANNED)
  note         String?

  participants        KegiatanParticipant[]
  payments            KegiatanPayment[]
  expenses            KegiatanExpense[]
  relatedCashExpenses CashExpense[] @relation("CashExpenseKegiatan")

  createdById String @db.Uuid
  createdUser User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp(6)

  @@index([eventDate])
}

model KegiatanParticipant {
  id String @id @default(uuid()) @db.Uuid

  kegiatanId String   @db.Uuid
  kegiatan   Kegiatan @relation(fields: [kegiatanId], references: [id], onDelete: Cascade)

  memberId String @db.Uuid
  member   Member @relation(fields: [memberId], references: [id])

  // attending=false = "patungan": tidak hadir tapi tetap iuran (nominal bisa
  // beda lewat expectedAmount). expectedAmount null = pakai feePerPerson.
  attending      Boolean @default(true)
  expectedAmount Int?

  joinedAt DateTime @default(now()) @db.Timestamp(6)

  createdById String @db.Uuid
  createdUser User   @relation(fields: [createdById], references: [id])

  @@unique([kegiatanId, memberId])
}

model KegiatanPayment {
  id String @id @default(uuid()) @db.Uuid

  kegiatanId String   @db.Uuid
  kegiatan   Kegiatan @relation(fields: [kegiatanId], references: [id], onDelete: Cascade)

  memberId String @db.Uuid
  member   Member @relation(fields: [memberId], references: [id])

  amount Int      // Nominal yang dibayar (bisa parsial — sengaja tanpa @@unique)
  paidAt DateTime @db.Date
  note   String?

  createdById String @db.Uuid
  createdUser User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamp(6)

  @@index([kegiatanId, memberId])
}

model KegiatanExpense {
  id String @id @default(uuid()) @db.Uuid

  kegiatanId String   @db.Uuid
  kegiatan   Kegiatan @relation(fields: [kegiatanId], references: [id], onDelete: Cascade)

  description String
  amount      Int
  spentAt     DateTime @db.Date

  createdById String @db.Uuid
  createdUser User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamp(6)
}

model AppSetting {
  key String @id

  value String

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp(6)
}

model ActivityLog {
  id String @id @default(uuid()) @db.Uuid

  actorId    String? @db.Uuid
  actorName  String?
  actorEmail String?

  action   String // CREATE | UPDATE | DELETE | LOGIN | LOGIN_FAILED | LOGOUT
  entity   String // cashPeriod | cashIncome | cashExpense | sosialPeriod | ... | user
  entityId String? // UUID entitas, atau key string untuk appSetting
  summary  String

  before Json?
  after  Json?

  createdAt DateTime @default(now()) @db.Timestamp(6)
}
