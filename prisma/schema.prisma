// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid()) @db.Uuid

  email    String  @unique
  name     String?
  password String

  createdMembers Member[]

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp(6)
}

enum Gender {
  MALE
  FEMALE
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

model Member {
  id String @id @default(uuid()) @db.Uuid

  name      String // Nama panggilan
  fullName  String // Nama lengkap
  gender    Gender
  birthDate DateTime @db.Date // Tanggal lahir (hanya tanggal, tanpa waktu)
  address   String
  phone     String? // Opsional, tidak semua pemuda punya HP

  status      MemberStatus @default(ACTIVE)
  createdById String       @db.Uuid
  createdUser User         @relation(fields: [createdById], references: [id])
  joinDate    DateTime     @default(now()) @db.Date // Tanggal bergabung

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp(6)
}
