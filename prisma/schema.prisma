// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid()) @db.Uuid

  email    String  @unique
  name     String?
  password String

  createdMembers Member[]
  createdCashPeriods CashPeriod[]
  createdCashIncomes CashIncome[]
  createdCashExpenses CashExpense[]
  createdSosialPeriods SosialPeriod[]
  createdSosialIncomes SosialIncome[]
  createdSosialExpenses SosialExpense[]

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp(6)
}

enum Gender {
  MALE
  FEMALE
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

model Member {
  id String @id @default(uuid()) @db.Uuid

  name      String // Nama panggilan
  fullName  String // Nama lengkap
  gender    Gender
  birthDate DateTime @db.Date // Tanggal lahir (hanya tanggal, tanpa waktu)
  address String // Dusun
  rt      String // Tiga digit, misalnya "013"
  rw      String // Tiga digit, misalnya "006"
  phone   String? // Opsional, tidak semua pemuda punya HP

  status      MemberStatus @default(ACTIVE)
  createdById String       @db.Uuid
  createdUser User         @relation(fields: [createdById], references: [id])
  joinDate    DateTime     @default(now()) @db.Date // Tanggal bergabung

  cashIncomes CashIncome[]

  sosialIncomes SosialIncome[]

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp(6)
}

model CashPeriod {
  id String @id @default(uuid()) @db.Uuid

  month      Int // 1-12
  year       Int // 2026
  duesAmount Int // Nominal iuran bulan ini
  minAmount  Int // Batas bawah

  incomes  CashIncome[]
  expenses CashExpense[]

  createdById String @db.Uuid
  createdUser User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp(6)

  @@unique([month, year])
}

model CashIncome {
  id String @id @default(uuid()) @db.Uuid

  periodId String     @db.Uuid
  period   CashPeriod @relation(fields: [periodId], references: [id])

  memberId String @db.Uuid
  member   Member @relation(fields: [memberId], references: [id])

  amount Int      // Nominal yang dibayar
  paidAt DateTime @db.Date
  note   String?  // Catatan opsional

  createdById String @db.Uuid
  createdUser User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamp(6)

  @@unique([periodId, memberId])
}

model CashExpense {
  id String @id @default(uuid()) @db.Uuid

  periodId    String     @db.Uuid
  period      CashPeriod @relation(fields: [periodId], references: [id])

  description String // "Beli konsumsi rapat", dll
  amount      Int
  spentAt     DateTime @db.Date

  createdById String @db.Uuid
  createdUser User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamp(6)
}

model SosialPeriod {
  id String @id @default(uuid()) @db.Uuid

  month     Int // 1-12
  year      Int // 2026
  minAmount Int // Batas bawah iuran seiklasnya

  incomes  SosialIncome[]
  expenses SosialExpense[]

  createdById String @db.Uuid
  createdUser User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp(6)

  @@unique([month, year])
}

model SosialIncome {
  id String @id @default(uuid()) @db.Uuid

  periodId String       @db.Uuid
  period   SosialPeriod @relation(fields: [periodId], references: [id])

  memberId String @db.Uuid
  member   Member @relation(fields: [memberId], references: [id])

  amount Int      // Nominal yang disumbangkan
  paidAt DateTime @db.Date
  note   String?  // Catatan opsional

  createdById String @db.Uuid
  createdUser User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamp(6)

  @@unique([periodId, memberId])
}

model SosialExpense {
  id String @id @default(uuid()) @db.Uuid

  periodId    String       @db.Uuid
  period      SosialPeriod @relation(fields: [periodId], references: [id])

  description String // "Beli konsumsi rapat", dll
  amount      Int
  spentAt     DateTime @db.Date

  createdById String @db.Uuid
  createdUser User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamp(6)
}
